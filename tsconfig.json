{
  "compilerOptions": {
    "target": "ES2020",
    "useDefineForClassFields": true,
    "lib": ["ES2020", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    // TypeScript 6 menandai baseUrl usang. Tanpa baseUrl, isi "paths"
    // dihitung relatif terhadap letak tsconfig ini, jadi cukup tambahkan "./".
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
